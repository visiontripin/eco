{
  "name": "podrabotka-msk",
  "private": true,
  "version": "1.0.0",
  "description": "Подработка.МСК — платформа быстрых смен в Москве и Московской области",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production NODE_NO_WARNINGS=1 tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build:static": "node scripts/build-static.mjs",
    "verify": "npm run typecheck && npm run build && npm run build:static"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
